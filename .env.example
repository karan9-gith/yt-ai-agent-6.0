# ==============================================================================
# ContentPilot AI — Master Environment Configuration Template
# Copy this file to .env and configure with your specific environment keys.
# NEVER commit your .env file or real credentials to source control.
# ==============================================================================

# Server & Application Environment
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_SECRET_KEY=

# SQLite Database Connection
DATABASE_URL=file:./dev.db

# Operational Safety & Editorial Governance Defaults (Zero Unauthorized Actions)
AUTO_PUBLISH=false
REQUIRE_HUMAN_APPROVAL=true
DEFAULT_YOUTUBE_PRIVACY=public

# Primary AI Provider: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Secondary AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voice & Media Asset Providers
TTS_PROVIDER=gemini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
IMAGE_PROVIDER=gemini
REPLICATE_API_TOKEN=

# YouTube Data API v3 & OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback

# Media Processing Engine Binaries
FFMPEG_PATH=
FFPROBE_PATH=

# Persistent Media Storage & Job Settings
STORAGE_DIR=./storage
MAX_CONCURRENT_RENDERS=1
JOB_WORKER_POLL_INTERVAL_MS=2000
JOB_HEARTBEAT_INTERVAL_SEC=30
JOB_MAX_ATTEMPTS=3
DISABLE_BACKGROUND_WORKERS=false

# Logging Level
LOG_LEVEL=info
