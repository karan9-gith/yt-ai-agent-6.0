{
  "name": "contentpilot-ai",
  "version": "1.0.0",
  "description": "Enterprise-grade autonomous YouTube automation platform with multi-agent orchestration",
  "private": true,
  "workspaces": [
    "backend",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=client",
    "build:backend": "npm run prisma:generate --workspace=backend && npm run build --workspace=backend",
    "start": "npm run start --workspace=backend",
    "start:worker": "npm run start:worker --workspace=backend",
    "typecheck": "npm run typecheck --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:push": "npm run prisma:push --workspace=backend"
  },
  "keywords": [
    "youtube-automation",
    "ai-agents",
    "video-production",
    "gemini",
    "ffmpeg",
    "content-creation"
  ],
  "author": "ContentPilot AI Team",
  "license": "MIT"
}
